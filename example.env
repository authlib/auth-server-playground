# Auth Server Playground configuration
# Copy this file to .env and fill in your values

# Key that signs the session cookies (optional).
# Without it, the server generates a key and stores it in the database.
# SECRET_KEY="change-this-to-a-random-secret-key"

# SQLAlchemy database URL. A relative SQLite path goes in the instance folder.
DATABASE_URL="sqlite:///db.sqlite"

# Snapshot file loaded when the database is empty (optional)
# INITIAL_SNAPSHOT="snapshot.json"

# Flask server configuration (optional)
FLASK_RUN_HOST="127.0.0.1"
FLASK_RUN_PORT="3000"
FLASK_DEBUG="True"

# Set to true when running behind a reverse proxy (optional)
# PROXY_FIX="true"

# Allow plain HTTP for OAuth endpoints. Never set this in production.
AUTHLIB_INSECURE_TRANSPORT="1"
