msgstr "Rétablir les valeurs par défaut"

#: src/auth_server_playground/templates/admin/server.html:33
msgid "OpenID Connect"
msgstr "OpenID Connect"

#: src/auth_server_playground/templates/admin/server.html:34
msgid "On when the scopes hold <code>openid</code>."
msgstr "Actif quand les portées contiennent <code>openid</code>."

#: src/auth_server_playground/templates/admin/snapshot.html:5
msgid ""
"A snapshot is a JSON file with the server configuration, the personas, "
"the clients and the signing keys."
msgstr ""
"Un instantané est un fichier JSON qui contient la configuration du "
"serveur, les personas, les clients et les clés de signature."

#: src/auth_server_playground/templates/admin/snapshot.html:8
msgid "Export"
msgstr "Exporter"

#: src/auth_server_playground/templates/admin/snapshot.html:9
msgid "Download the current state of the playground."
msgstr "Télécharger l'état actuel du playground."

#: src/auth_server_playground/templates/admin/snapshot.html:10
msgid "The file holds the client secrets and the private keys."
msgstr "Le fichier contient les secrets des clients et les clés privées."

#: src/auth_server_playground/templates/admin/snapshot.html:12
msgid "Download the snapshot"
msgstr "Télécharger l'instantané"

#: src/auth_server_playground/templates/admin/snapshot.html:21
msgid "You confirm on the next page. Nothing changes before."
msgstr "Vous confirmez à la page suivante. Rien ne change avant."

#: src/auth_server_playground/templates/admin/snapshot_confirm.html:4
#: src/auth_server_playground/templates/admin/snapshot_confirm.html:6
msgid "Import a snapshot"
msgstr "Importer un instantané"

#: src/auth_server_playground/templates/admin/snapshot_confirm.html:8
msgid "Replace everything?"
msgstr "Tout remplacer ?"

#: src/auth_server_playground/templates/admin/snapshot_confirm.html:9
msgid "The playground will hold the content of the file:"
msgstr "Le playground contiendra le contenu du fichier :"

#: src/auth_server_playground/templates/admin/snapshot_confirm.html:11
msgid "the server configuration;"
msgstr "la configuration du serveur ;"

#: src/auth_server_playground/templates/admin/snapshot_confirm.html:12
#, python-format
msgid "%(count)s persona;"
msgid_plural "%(count)s personas;"
msgstr[0] "%(count)s persona ;"
msgstr[1] "%(count)s personas ;"

#: src/auth_server_playground/templates/admin/snapshot_confirm.html:13
#, python-format
msgid "%(count)s client;"
msgid_plural "%(count)s clients;"
msgstr[0] "%(count)s client ;"
msgstr[1] "%(count)s clients ;"

#: src/auth_server_playground/templates/admin/snapshot_confirm.html:14
#, python-format
msgid "%(count)s key."
msgid_plural "%(count)s keys."
msgstr[0] "%(count)s clé."
msgstr[1] "%(count)s clés."

#: src/auth_server_playground/templates/admin/snapshot_confirm.html:16
msgid ""
"The current personas, clients and keys are deleted, with all the codes, "
"tokens and consents. The selected persona is forgotten."
msgstr ""
"Les personas, clients et clés actuels sont supprimés, avec tous les "
"codes, jetons et consentements. La persona choisie est oubliée."

#: src/auth_server_playground/templates/admin/snapshot_confirm.html:21
msgid "Cancel"
msgstr "Annuler"

#: src/auth_server_playground/templates/interaction/consent.html:3
msgid "Consent"
msgstr "Consentement"

#: src/auth_server_playground/templates/interaction/consent.html:8
#, python-format
msgid "%(client)s asks for access"
msgstr "%(client)s demande un accès"

#: src/auth_server_playground/templates/interaction/consent.html:10
#, python-format
msgid "You act as <strong>%(persona)s</strong>."
msgstr "Vous agissez en tant que <strong>%(persona)s</strong>."

#: src/auth_server_playground/templates/interaction/consent.html:11
msgid "Change persona"
msgstr "Changer de persona"

#: src/auth_server_playground/templates/interaction/consent.html:14
msgid "Requested scopes:"
msgstr "Portées demandées :"

#: src/auth_server_playground/templates/interaction/consent.html:22
msgid "Claims requested beyond the scopes:"
msgstr "Claims demandées au-delà des portées :"

#: src/auth_server_playground/templates/interaction/consent.html:30
msgid "Authorization request"
msgstr "Requête d'autorisation"

#: src/auth_server_playground/templates/interaction/select_persona.html:3
#: src/auth_server_playground/templates/interaction/select_persona.html:8
msgid "Choose a persona"
msgstr "Choisir une persona"

#: src/auth_server_playground/templates/interaction/select_persona.html:12
#, python-format
msgid "<strong>%(client_name)s</strong> asks you to sign in."
msgstr "<strong>%(client_name)s</strong> vous demande de vous connecter."

#: src/auth_server_playground/templates/interaction/select_persona.html:14
msgid "The playground does not check passwords: pick who you act as."
msgstr ""
"Le playground ne vérifie aucun mot de passe : choisissez qui vous "
"incarnez."

#: src/auth_server_playground/templates/interaction/select_persona.html:48
msgid "Continue with a new random persona"
msgstr "Continuer avec une nouvelle persona aléatoire"

